<?xml version="1.0" encoding="utf-8"?>
<!--
  Styleable of the custom analog clock view.

  RESTORED: AnalogClock.handleAttrs() reads attribute index 0 of this styleable
  (obtainStyledAttributes(attributeSet, R.styleable.CustomAnalogClock, 0, 0) followed by
  hasValue(0) / getBoolean(0, true)). A previous change emptied the declare-styleable, so the
  returned TypedArray had length 0 and hasValue(0) threw ArrayIndexOutOfBoundsException the
  moment any screen inflated AnalogClock from XML. That one crash took out:

    * the Analog Clock grid (item_clocks.xml has an AnalogClock in every tile), and
    * the clock editor (activity_editor.xml inflates an AnalogClock even when it is GONE for
      the digital / smart clock types),

  which is why no clock content could be displayed at all and only the section header stayed
  visible. With the attribute back, hasValue(0) is a valid query again: every current XML
  usage leaves it unset, so the view takes the original path (init with a default dial before
  the adapter binds the real clock). No layout has to set it; it only exists so the index the
  Java code reads is real.
-->
<resources>
    <declare-styleable name="CustomAnalogClock">
        <attr name="autoInit" format="boolean" />
    </declare-styleable>
</resources>
