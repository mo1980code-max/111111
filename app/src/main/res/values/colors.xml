    <!--
      Quran reader palette. Single source of truth for the Surah Index and the reader screens;
      used by res/values/quran.xml, res/layout/activity_surah_list.xml, item_surah.xml and
      activity_quran.xml. Do not redefine these values elsewhere.
    -->

    <!-- Background: paper colour behind the whole reader and the index screen. -->
    <color name="quran_background">#FBF9F0</color>
    <!-- Text: Arabic verse ink and primary list text. -->
    <color name="quran_text">#1A1A1A</color>
    <!-- Highlight: selection / pressed tint, e.g. a tapped surah row. -->
    <color name="quran_highlight">#D0ECE4</color>
    <!-- Header: surah name, Juz and page labels (muted secondary text). -->
    <color name="quran_header">#7A7A7A</color>
    <!-- Buttons: Next Surah / Previous Surah and the home-screen Quran pill. -->
    <color name="quran_button">#2D7D46</color>

    <!-- Supporting shades derived from the five colours above. -->
    <!-- Pressed state for quran_button, so taps give feedback without a new hue. -->
    <color name="quran_button_pressed">#246438</color>
    <!-- Foreground for text drawn on top of quran_button. -->
    <color name="quran_on_button">#FBF9F0</color>
    <!-- Hairline separators on quran_background, darker than the highlight. -->
    <color name="quran_divider">#E8E4D5</color>
    <!-- Surah number badge fill: the highlight tint, kept away from pure white. -->
    <color name="quran_badge">#EFEADA</color>
    <!-- Load/permission errors on quran_background. -->
    <color name="quran_error">#C62828</color>

    <!--
      Azkar palette. Single source of truth for the Azkar home and category screens;
      used by res/values/azkar.xml and the activity_azkar_*/item_azkar layouts.
      Deep emerald + emerald + soft gold on ivory/warm white: peaceful, premium Islamic feel.
    -->

    <!-- Screen background: warm ivory. -->
    <color name="azkar_background">#FAF7EE</color>
    <!-- Card surface: warm white. -->
    <color name="azkar_card">#FFFDF7</color>
    <!-- Primary text: deep green-charcoal ink. -->
    <color name="azkar_text">#22312A</color>
    <!-- Secondary text: muted warm grey. -->
    <color name="azkar_muted">#7C7666</color>
    <!-- Primary action / completed state: emerald green. -->
    <color name="azkar_primary">#0E7C5B</color>
    <!-- Pressed state for azkar_primary. -->
    <color name="azkar_primary_dark">#0A5C44</color>
    <!-- Deep emerald: header accents and evening tile. -->
    <color name="azkar_deep">#0B3D2E</color>
    <!-- Soft gold: badges, icon accents, card strokes. -->
    <color name="azkar_gold">#C9A227</color>
    <!-- Pale gold wash behind number badges. -->
    <color name="azkar_gold_soft">#F3E9C8</color>
    <!-- Foreground for text drawn on top of azkar_primary. -->
    <color name="azkar_on_primary">#FFFFFF</color>
    <!-- Completed card wash: subtle green tint. -->
    <color name="azkar_completed_bg">#E5F3EB</color>
    <!-- Hairline separators and card strokes on azkar_background. -->
    <color name="azkar_divider">#E6E0CE</color>
    <!-- Progress track behind the emerald progress fill. -->
    <color name="azkar_track">#E9E4D2</color>
</resources>
