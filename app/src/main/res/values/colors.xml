<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the values the PLATFORM needs (window background, splash, launcher, widgets) live here.
  The in-app Compose palette is defined once in ui/theme/Color.kt so there is a single source of
  truth for the app surfaces.
-->
<resources>
    <color name="window_background">#FBF7F0</color>
    <color name="splash_background">#0A3D2F</color>
    <color name="ic_launcher_background">#0A3D2F</color>

    <!-- Home-screen widgets (light) -->
    <color name="widget_surface">#FBF7F0</color>
    <color name="widget_surface_alt">#F2EADC</color>
    <color name="widget_ink">#17241F</color>
    <color name="widget_ink_muted">#5C6B63</color>
    <color name="widget_emerald">#0A3D2F</color>
    <color name="widget_gold">#B08D51</color>
    <color name="widget_hairline">#1A0A3D2F</color>
</resources>
