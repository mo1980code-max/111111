<?xml version="1.0" encoding="utf-8"?>
<!--
  Azkar display-settings bottom sheet (shown by AzkarSettingsSheet from either Azkar screen).

  Three sections, top to bottom:
    1. Text size  - A- / current size / A+ (persisted as "dhikr_font_size")
    2. Font      - Default / Amiri / Cairo / Tajawal (persisted as "dhikr_font_family")
    3. Night mode - on/off switch, Azkar section only (persisted as "azkar_night_mode")

  Day colours are set here as the default; the sheet repaints itself for the night
  palette at show time. Changing any setting never touches the counters.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/azkar_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_azkar_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_azkar_chip" />

    <TextView
        android:id="@+id/azkar_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/azkar_sheet_title"
        android:textColor="@color/azkar_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 1. Text size -->
    <TextView
        android:id="@+id/azkar_sheet_size_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/azkar_font_label"
        android:textColor="@color/azkar_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/azkar_font_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/azkar_cd_font_minus"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="A-"
            android:textColor="@color/azkar_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/azkar_font_size_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/azkar_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/azkar_font_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/azkar_cd_font_plus"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="A+"
            android:textColor="@color/azkar_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/azkar_divider" />

    <!-- 2. Font family -->
    <TextView
        android:id="@+id/azkar_sheet_font_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/azkar_sheet_font_label"
        android:textColor="@color/azkar_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/azkar_font_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/azkar_font_default"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/azkar_font_default"
            android:textColor="@color/azkar_text"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/azkar_font_amiri"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/azkar_font_amiri"
            android:textColor="@color/azkar_text"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/azkar_font_cairo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/azkar_font_cairo"
            android:textColor="@color/azkar_text"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/azkar_font_tajawal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/azkar_font_tajawal"
            android:textColor="@color/azkar_text"
            android:textSize="15sp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/azkar_divider" />

    <!-- 3. Night mode (Azkar section only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/azkar_night_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/azkar_sheet_night_label"
            android:textColor="@color/azkar_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/azkar_night_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp" />
    </LinearLayout>
</LinearLayout>
