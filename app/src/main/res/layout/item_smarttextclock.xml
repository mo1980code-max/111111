<?xml version="1.0" encoding="utf-8"?>
<com.clock.livewallpaper.viewUtils.SquareRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="10dp"
    app:cardBackgroundColor="@color/themeDarkColor"
    app:cardCornerRadius="15dp"
    app:cardUseCompatPadding="true">

    <ImageView
        android:id="@+id/clockwise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/lockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lock_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lockBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_lock_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="7dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@string/content_locked"
            android:src="@drawable/ic_locked" />

        <TextView
            android:id="@+id/lockLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/content_locked"
            android:textColor="@color/lock_badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.clock.livewallpaper.viewUtils.SquareRelativeLayout>
