<?xml version="1.0" encoding="utf-8"?>
<!--
  Azkar category screen (Morning / Evening / Tasbeeh), opened from AzkarHomeActivity.

  Regions, top to bottom:
    1. Header   - back arrow, category title + Arabic subtitle (set at runtime),
                  settings button opening the display-settings bottom sheet
    2. Progress - "7 / 31 Completed" with a progress bar, computed from the actual
                  imported items; an emerald "All Azkar Completed" banner when done
    3. List     - RecyclerView of item_azkar cards with countdown counters
    4. Footer   - data-source attribution for the current category
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/azkar_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azkar_background"
    android:orientation="vertical"
    tools:context=".activity.AzkarListActivity">

    <!-- 1. Screen header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/azkar_list_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/azkar_cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/azkar_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/azkar_list_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/azkar_text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Morning Azkar" />

            <TextView
                android:id="@+id/azkar_list_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/azkar_muted"
                android:textSize="13sp"
                tools:text="أذكار الصباح" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/azkar_list_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/azkar_settings_cd"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tune"
            android:tint="@color/azkar_muted" />
    </LinearLayout>

    <!-- 2. Overall progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/azkar_list_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/azkar_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="7 / 31 Completed" />

        <ProgressBar
            android:id="@+id/azkar_list_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:progressDrawable="@drawable/azkar_progress"
            tools:progress="7" />

        <TextView
            android:id="@+id/azkar_list_all_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/azkar_all_completed"
            android:textColor="@color/azkar_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:id="@+id/azkar_list_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/azkar_divider" />

    <!-- 3. Azkar cards -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/azkar_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical"
            tools:itemCount="3"
            tools:listitem="@layout/item_azkar" />

        <TextView
            android:id="@+id/azkar_list_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/azkar_load_error"
            android:textColor="@color/azkar_muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/azkar_list_divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/azkar_divider" />

    <!-- 4. Source attribution travels with the shipped text -->
    <TextView
        android:id="@+id/azkar_list_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/azkar_muted"
        android:textSize="11sp"
        tools:text="Source: islambook.com" />
</LinearLayout>
