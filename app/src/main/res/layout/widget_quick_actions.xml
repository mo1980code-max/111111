<?xml version="1.0" encoding="utf-8"?>
<!-- Quick actions widget: morning, evening, tasbeeh. Each tile opens its Compose destination. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_action_morning"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_bg"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_morning"
            android:src="@drawable/ic_sun"
            android:tint="@color/widget_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_morning"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_evening"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_bg"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_evening"
            android:src="@drawable/ic_moon"
            android:tint="@color/widget_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_evening"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_tasbeeh"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_bg"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_tasbeeh"
            android:src="@drawable/ic_nav_tasbeeh"
            android:tint="@color/widget_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_tasbeeh"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
