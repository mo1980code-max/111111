<?xml version="1.0" encoding="utf-8"?>
<!--
  One Azkar card: number badge, repeat-count chip, the full Arabic text (RTL, Amiri),
  the virtue line from the source, and a large counter button.

  The card root is RTL so the Arabic content reads naturally; the counter button is
  pinned LTR so the remaining number always renders in the familiar order. Only the
  counter button advances the count — the rest of the card is safe to touch while scrolling.

  Countdown semantics: the button shows what is LEFT, starting from the item's own
  repeatCount (e.g. 3) and decreasing to 0. There is no reset control: counters live
  only while the screen is open and restart from their original numbers on reopen.

  Completed state (applied at bind time): bg_azkar_card_completed on the card and
  bg_azkar_counter_completed on the button, with white counter text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/azkar_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_azkar_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Number and required repetitions (no reset: counters restart on reopen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/azkar_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_azkar_badge"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/azkar_deep"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Azkar #2" />

        <TextView
            android:id="@+id/azkar_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_azkar_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/azkar_card"
            android:textSize="12sp"
            tools:text="Repeat 3x" />

    </LinearLayout>

    <!-- The dhikr itself, verbatim from the source -->
    <TextView
        android:id="@+id/azkar_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/azkar_text"
        android:textSize="20sp"
        tools:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ" />

    <!-- Virtue / reward line from the source, when the source gives one -->
    <TextView
        android:id="@+id/azkar_virtue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/azkar_muted"
        android:textSize="13sp"
        tools:text="حُطَّتْ خَطَايَاهُ وَإِنْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/azkar_divider" />

    <!-- Large counter button: the only view that advances the count -->
    <LinearLayout
        android:id="@+id/azkar_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_azkar_counter"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/azkar_counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/azkar_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="3" />

        <TextView
            android:id="@+id/azkar_counter_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/azkar_tap_to_count"
            android:textColor="@color/azkar_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
