<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/allah_name_card"
    android:layout_width="match_parent"
    android:layout_height="182dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_allah_theme_navy"
    android:clipToOutline="true"
    android:elevation="3dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:importantForAccessibility="yes"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="28dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- Arabic is a real TextView, so shaping and RTL remain correct on every device. -->
        <TextView
            android:id="@+id/allah_name_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="2"
            android:textColor="@color/allah_card_text"
            android:textDirection="rtl"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="الرَّحْمَنُ" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="8dp"
            android:background="@color/allah_divider" />

        <TextView
            android:id="@+id/allah_name_transliteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/allah_card_muted"
            android:textDirection="ltr"
            android:textSize="12sp"
            tools:text="Ar-Rahman" />
    </LinearLayout>

    <!-- Locked cards remain fully visible; this is only a soft state scrim. -->
    <View
        android:id="@+id/lockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_allah_name_lock_scrim"
        android:visibility="gone" />

    <TextView
        android:id="@+id/allah_name_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_allah_number_badge"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/allah_number_text"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="#1" />

    <LinearLayout
        android:id="@+id/lockBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_allah_lock_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="4dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/allah_name_locked"
            android:src="@drawable/ic_locked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/content_locked"
            android:textColor="@color/allah_lock_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
