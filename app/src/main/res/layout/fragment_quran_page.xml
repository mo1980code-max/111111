<?xml version="1.0" encoding="utf-8"?>
<!--
  One page of the reader's ViewPager2: a whole surah.

  Layout regions, overlaid (never shown together):
    1. Body    - scrollable, centred Arabic TextView in assets/fonts/quran_font.ttf
    2. Status  - loading spinner / error message / Retry

  The body text is pinned RTL; the page itself is hosted by an LTR-pinned pager so swipe direction
  stays physical. The body font is applied from Java with Typeface.createFromAsset(); an asset path
  cannot be referenced from XML (only res/font can). QuranFragment reports a missing font instead
  of silently substituting a system face.

  Colours are the LIGHT defaults; QuranFragment re applies them from QuranThemeColors so the dark
  palette can be switched on at runtime and persisted.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quran_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quran_background"
    tools:context=".activity.QuranFragment">

    <!-- 1. Body: scrollable, centred Arabic text -->
    <ScrollView
        android:id="@+id/quran_page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:saveEnabled="false"
        android:scrollbars="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/quran_page_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="true"
            android:layoutDirection="rtl"
            android:lineSpacingExtra="10dp"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="18dp"
            android:paddingBottom="24dp"
            android:saveEnabled="false"
            android:textColor="@color/quran_text"
            android:textColorHighlight="@color/quran_highlight"
            android:textDirection="rtl"
            android:textIsSelectable="true"
            android:textSize="26sp"
            tools:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
    </ScrollView>

    <!-- 2. Status: spinner while loading, message plus Retry on failure -->
    <LinearLayout
        android:id="@+id/quran_page_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/quran_page_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/quran_loading"
            android:indeterminateTint="@color/quran_button" />

        <TextView
            android:id="@+id/quran_page_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/quran_loading"
            android:textColor="@color/quran_header"
            android:textSize="15sp" />

        <Button
            android:id="@+id/quran_page_retry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_quran_nav_button"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="@string/quran_retry"
            android:textAllCaps="false"
            android:textColor="@color/quran_nav_button_text"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
