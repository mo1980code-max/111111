<?xml version="1.0" encoding="utf-8"?>
<!--
  Quran reading screen: a ViewPager2 with one QuranFragment per surah, loaded offline from
  quran.ar.uthmani.db. Swiping left/right moves between surahs; the Next/Previous buttons of the
  earlier reader are gone.

  Layout regions, top to bottom:
    1. Toolbar - back arrow, "surah N of 114", font -, font +, bookmark, moon/sun theme toggle
    2. Header  - Surah Name (LEFT) and Juz Number (RIGHT), quran_header grey
    3. Body    - androidx.viewpager2.widget.ViewPager2; each page scrolls one whole surah
    4. Footer  - Page Number, centred

  Header and footer rows are pinned with android:layoutDirection="ltr" so "left" and "right" mean
  physical left and right in every device locale; the pager is pinned LTR for the same reason. The
  Arabic page text inside fragment_quran_page.xml stays RTL.

  Colours here are the LIGHT defaults; QuranActivity and QuranFragment reapply every colour from
  QuranThemeColors so the dark palette can be switched on at runtime and persisted.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quran_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quran_background"
    android:orientation="vertical"
    tools:context=".activity.QuranActivity">

    <!-- 1. Toolbar: back, position, spacer, then the four reading controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/quran_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/quran_header" />

        <TextView
            android:id="@+id/quran_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/quran_header"
            android:textSize="13sp"
            tools:text="2 of 114" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/quran_font_decrease"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_font_decrease"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_font_decrease"
            android:tint="@color/quran_header" />

        <ImageButton
            android:id="@+id/quran_font_increase"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_font_increase"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_font_increase"
            android:tint="@color/quran_header" />

        <ImageButton
            android:id="@+id/quran_bookmark"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_bookmark"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark"
            android:tint="@color/quran_header" />

        <ImageButton
            android:id="@+id/quran_theme_toggle"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_switch_to_dark"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_moon"
            android:tint="@color/quran_header" />
    </LinearLayout>

    <!-- 2. Header: Surah Name (left), Juz Number (right); pinned chrome, never swiped away -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/quran_surah_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="سورة البقرة" />

        <TextView
            android:id="@+id/quran_juz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:maxLines="1"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="15sp"
            tools:text="الجزء ١" />
    </LinearLayout>

    <View
        android:id="@+id/quran_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quran_divider" />

    <!-- 3. Body: one QuranFragment per surah. LTR-pinned so a left swipe always means "next". -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/quran_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutDirection="ltr" />

    <View
        android:id="@+id/quran_divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quran_divider" />

    <!-- 4. Footer: Mushaf page of the selected surah, centred -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/quran_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="86dp"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="14sp"
            tools:text="صفحة ٢" />
    </LinearLayout>
</LinearLayout>
