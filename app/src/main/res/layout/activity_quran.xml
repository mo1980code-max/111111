<?xml version="1.0" encoding="utf-8"?>
<!--
  Quran reading screen: one whole surah, loaded offline from quran.ar.uthmani.db.

  Layout regions, top to bottom:
    1. Navigation bar  - back arrow (left) and "surah N of 114" (right)
    2. Header          - Surah Name (LEFT) and Juz Number (RIGHT), both #7A7A7A
    3. Body            - scrollable, centred Arabic TextView in assets/fonts/quran_font.ttf
    4. Footer          - Previous Surah (left), Page Number (centre), Next Surah (right), #2D7D46

  Header and footer rows are pinned with android:layoutDirection="ltr" so "left" and "right" mean
  physical left and right in every device locale. The Arabic body text is pinned RTL independently.

  The body font is applied from Java with Typeface.createFromAsset(); an asset path cannot be
  referenced from XML (only res/font can). QuranActivity reports a missing font instead of silently
  substituting a system face.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quran_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quran_background"
    android:orientation="vertical"
    tools:context=".activity.QuranActivity">

    <!-- 1. Navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/quran_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/quran_header" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/quran_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/quran_header"
            android:textSize="13sp"
            tools:text="2 of 114" />
    </LinearLayout>

    <!-- 2. Header: Surah Name (left), Juz Number (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/quran_surah_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="سورة البقرة" />

        <TextView
            android:id="@+id/quran_juz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:maxLines="1"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="15sp"
            tools:text="الجزء ١" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quran_divider" />

    <!-- 3. Body: scrollable, centred Arabic text (or the loading/error state, never both) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/quran_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:saveEnabled="false"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/quran_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="true"
                android:layoutDirection="rtl"
                android:lineSpacingExtra="10dp"
                android:lineSpacingMultiplier="1.25"
                android:paddingTop="18dp"
                android:paddingBottom="24dp"
                android:saveEnabled="false"
                android:textColor="@color/quran_text"
                android:textColorHighlight="@color/quran_highlight"
                android:textDirection="rtl"
                android:textIsSelectable="true"
                android:textSize="26sp"
                tools:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/quran_loading_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/quran_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/quran_loading"
                android:indeterminateTint="@color/quran_button" />

            <TextView
                android:id="@+id/quran_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/quran_loading"
                android:textColor="@color/quran_header"
                android:textSize="15sp" />

            <Button
                android:id="@+id/quran_retry_btn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_quran_nav_button"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="@string/quran_retry"
                android:textAllCaps="false"
                android:textColor="@color/quran_nav_button_text"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quran_divider" />

    <!-- 4. Footer: Previous Surah | Page Number | Next Surah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/quran_prev_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quran_nav_button"
            android:contentDescription="@string/quran_cd_previous_surah"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quran_previous_surah"
            android:textAllCaps="false"
            android:textColor="@color/quran_nav_button_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quran_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:minWidth="86dp"
            android:textColor="@color/quran_header"
            android:textDirection="rtl"
            android:textSize="14sp"
            tools:text="صفحة ٢" />

        <Button
            android:id="@+id/quran_next_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quran_nav_button"
            android:contentDescription="@string/quran_cd_next_surah"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quran_next_surah"
            android:textAllCaps="false"
            android:textColor="@color/quran_nav_button_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
