<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the full-text search results on the Surah Index screen.

  Physical layout is LTR-anchored (android:layoutDirection="ltr") so the Latin reference line and
  the Arabic excerpt keep their designed placement in every device locale; the excerpt itself is
  explicitly RTL. The whole row is the click target, opening the reader scrolled to this ayah.

  The excerpt face is applied from Java (assets/fonts/quran_font.ttf) by AyahSearchAdapter; row
  colours come from QuranThemeColors at bind time so the dark palette needs only a rebind.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_result_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="ltr"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp"
    tools:background="@color/quran_background">

    <!-- Reference line, e.g. "Al-Baqarah 2:255", in the accent green so results scan quickly. -->
    <TextView
        android:id="@+id/search_result_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/quran_button"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Al-Baqarah 2:255" />

    <!-- Arabic excerpt: the matched ayah verbatim, capped at three lines. -->
    <TextView
        android:id="@+id/search_result_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:textColor="@color/quran_text"
        android:textDirection="rtl"
        android:textSize="19sp"
        tools:text="ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ٱلْحَىُّ ٱلْقَيُّومُ" />
</LinearLayout>
