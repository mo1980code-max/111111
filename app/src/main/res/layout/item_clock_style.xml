<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_style_card"
    android:layout_width="132dp"
    android:layout_height="72dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/clock_style_accent"
        android:layout_width="34dp"
        android:layout_height="3dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/clock_style_preview"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:textColor="@color/clock_studio_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clock_style_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/clock_studio_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clock_style_family"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/clock_studio_muted"
        android:textSize="10sp" />
</LinearLayout>
