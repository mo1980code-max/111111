<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the reader footer's "Previous Surah" / "Next Surah" buttons.
  Enabled: #2D7D46 (quran_button), pressed: #246438. Disabled at the ends of the Mushaf
  (surah 1 has no previous, surah 114 has no next) so the state is obvious without a toast.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/quran_divider" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quran_button_pressed" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/quran_button" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
