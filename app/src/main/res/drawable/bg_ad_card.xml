<?xml version="1.0" encoding="utf-8"?>
<!-- In-feed native ad card: rounded, stroked, warm paper. Content tiles are dark and unframed,
     so an ad can never be mistaken for one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ad_surface" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ad_stroke" />
</shape>
