<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#661D3A38" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#557D9699" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9C2944A" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#FFF5D38A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#CC1B6D5A" android:endColor="#CC8B6726" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#F0D58A" />
        </shape>
    </item>
</selector>
