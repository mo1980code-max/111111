<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission budget (minimum for the retained product features):

    INTERNET              the only network client in the app is the Google Mobile Ads SDK
    SYSTEM_ALERT_WINDOW   the floating dhikr card drawn over other apps (optional at runtime)
    POST_NOTIFICATIONS    Android 13+ runtime permission for reminder notifications (optional)
    RECEIVE_BOOT_COMPLETED  re-arms the enabled alarms after a reboot
    VIBRATE               the optional short haptic of the tasbeeh / floating card

  Deliberately absent: ACCESS_NETWORK_STATE, READ/WRITE_EXTERNAL_STORAGE, SET_WALLPAPER and
  WAKE_LOCK - the dhikr content, the counter, the reminders and the widgets are all local, and
  nothing but the ads SDK talks to a server. com.google.android.gms.permission.AD_ID is not
  declared here either; it arrives from the Mobile Ads SDK's own manifest, which is where it
  belongs. No SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM: reminders use inexact alarms on purpose.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DhikrApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Dhikr.Starting">

        <!--
          Google's official AdMob sample application id. It is the only advertising identifier in
          the manifest; the unit ids live in ads/AdConfig.kt and are Google's official test units
          as well, so no real inventory can ever be requested by this build.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Dhikr.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Periodic dhikr reminder: inexact AlarmManager alarm, re-armed after every delivery. -->
        <receiver
            android:name=".reminder.DhikrReminderReceiver"
            android:exported="false" />

        <!-- Morning / evening / Friday reminders. -->
        <receiver
            android:name=".reminder.DailyReminderReceiver"
            android:exported="false" />

        <!--
          Re-arms only the schedules the user actually enabled; never opens UI.

          All four actions are protected system broadcasts and are on the exception list of the
          Android 8+ implicit-broadcast ban, so a manifest registration still receives them.
          LOCKED_BOOT_COMPLETED is intentionally not declared: the app is not directBootAware, so
          it cannot run - nor read its credential-encrypted settings - before the first unlock,
          and BOOT_COMPLETED arrives right after it.
        -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.DhikrWidgetProvider"
            android:label="@string/widget_dhikr_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dhikr_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickActionsWidgetProvider"
            android:label="@string/widget_quick_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

    </application>

</manifest>
