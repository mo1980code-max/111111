<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No internet permission at all: the whole game - lessons, clock, mini games, progress,
        rewards and sound - works completely offline. Nothing is uploaded, no account is needed and
        no personal data is collected.
    -->
    <!-- The reminder uses an inexact repeating alarm, so no exact-alarm permission is needed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="false"
        android:xlargeScreens="true" />

    <application
        android:name=".ClockAdventureApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClockAdventure"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!--
            No fixed android:screenOrientation here: MainActivity locks phones to portrait itself
            (the right call for a one-handed child's game) but lifts that lock on tablets and the
            moment the window is put into split screen / free-form multi-window, where Android does
            not allow a fixed orientation anyway. android:resizeableActivity is true so the app can
            be freely resized in multi-window instead of being letterboxed or restarted, and every
            config change it cares about (orientation, screenSize, screenLayout, ...) is listed so
            rotating or resizing never recreates the activity - see MainActivity.applyOrientationLock.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|locale|layoutDirection|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ClockAdventure"
            tools:ignore="DiscouragedApi,SourceLockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/ads_app_id_placeholder_disabled" />
    </application>

</manifest>
